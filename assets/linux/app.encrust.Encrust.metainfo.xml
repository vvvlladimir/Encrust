<?xml version="1.0" encoding="UTF-8"?>
<!-- What a software centre shows for Encrust; see docs/decisions/0456. -->
<component type="desktop-application">
  <id>app.encrust.Encrust</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>AGPL-3.0-only</project_license>
  <name>Encrust</name>
  <summary>Slice models for resin 3D printers</summary>
  <developer id="app.encrust">
    <name>Encrust contributors</name>
  </developer>

  <description>
    <p>
      Encrust is a free slicer for MSLA and SLA resin printers. It checks every layer for
      islands, suction cups and weak necks before you print, counted from what will really cure
      after supports and hollowing.
    </p>
    <ul>
      <li>Automatic branching supports, manual placement, painted patches and rafts</li>
      <li>Hollowing with infill lattices, drain holes and a warning for trapped resin</li>
      <li>STL, OBJ and 3MF import with mesh repair, auto-orient and auto-arrange</li>
      <li>Cutting with joints, text and textures pressed into the surface</li>
      <li>Adaptive layer height, anti-aliasing and exposure by height</li>
      <li>Writes and reads back .goo, .ctb, .cbddlp, .pwmx, .sl1 and more</li>
      <li>Sends prints over the network to SDCP and PrusaLink printers</li>
    </ul>
  </description>

  <launchable type="desktop-id">app.encrust.Encrust.desktop</launchable>
  <provides>
    <binary>encrust-gui</binary>
    <binary>encrust</binary>
    <mediatype>application/x-encrust</mediatype>
  </provides>

  <url type="homepage">https://encrust.app</url>
  <url type="help">https://encrust.app/guides/</url>
  <url type="bugtracker">https://github.com/vvvlladimir/Encrust/issues</url>
  <url type="vcs-browser">https://github.com/vvvlladimir/Encrust</url>
  <url type="contribute">https://github.com/vvvlladimir/Encrust/blob/main/CONTRIBUTING.md</url>

  <screenshots>
